MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me
MONGO_HOST_PORT=27017
# Note: the port in MONGO_URI must match MONGO_HOST_PORT
MONGO_URI=mongodb://admin:change_me@localhost:27017/?authSource=admin
MONGO_DB=skills_mirage_db

JWT_SECRET_KEY=generate_with_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
GEMINI_API_KEY_WORKERANALYSIS=
GEMINI_API_KEY_RESKILLING=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Chatbot Spark warm-up at API start-up (1 = on, 0 = off)
CHATBOT_WARMUP=1

# Hive metastore database password (cluster only, config/cluster/docker-compose.yml)
HIVE_DB_PASSWORD=change_me_too

# Ingestion (src/ingestion). The course sheet address is NOT in the repo; ask the team.
# COURSES_SHEET_BASE_URL=https://docs.google.com/spreadsheets/d/e/<id>/pub
# COURSES_SWAYAM_TABS=CEC:<gid>,IIMB:<gid>
# COURSES_NPTEL_TAB=<gid>
SCRAPER_MAX_PAGES=5
SCRAPER_CITY=india
SCRAPER_HEADLESS=1
