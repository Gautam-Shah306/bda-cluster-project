<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- D-012: 8 MB blocks and 2 replicas, so a 52 MB file shows a visible block spread over both DataNodes. -->
  <property><name>dfs.blocksize</name><value>8388608</value></property>
  <property><name>dfs.replication</name><value>2</value></property>
  <property><name>dfs.namenode.name.dir</name><value>file:///hadoop/dfs/name</value></property>
  <property><name>dfs.datanode.data.dir</name><value>file:///hadoop/dfs/data</value></property>
  <property><name>dfs.namenode.http-address</name><value>0.0.0.0:9870</value></property>
  <property><name>dfs.webhdfs.enabled</name><value>true</value></property>
  <!-- Development cluster: no HDFS permission checks. -->
  <property><name>dfs.permissions.enabled</name><value>false</value></property>
</configuration>
